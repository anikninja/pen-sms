// Cloudflare Worker for INX SMS: the API and database boundary (see API.md).
// The top level is for local development (`wrangler dev`, tests); production is `env.production`
// (docs/deployment.md). Secrets are never written here: locally they come from worker/.dev.vars
// (git-ignored), in Cloudflare from Wrangler secrets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Not the production name: a `wrangler deploy` without `--env production` can never replace the
  // production Worker, and it gets no public URL.
  "name": "inxapp-sms-api-local",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  // Must not be later than the bundled workerd supports (wrangler 4.135 → workerd 2026-09-18).
  "compatibility_date": "2026-09-01",
  // Prisma's Workers build (wasm engine) expects Node.js compatibility APIs.
  "compatibility_flags": ["nodejs_compat"],
  // Smaller upload and faster cold starts; source maps keep stack traces readable in the logs.
  "minify": true,
  "upload_source_maps": true,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inxapp-sms",
      // Local development only (its value just names the local database file); never deployed.
      "database_id": "00000000-0000-4000-8000-000000000000",
      // The D1 SQL migrations (never the PostgreSQL ones in prisma/migrations).
      "migrations_dir": "../prisma/d1/migrations"
    }
  ],

  "r2_buckets": [
    {
      // Submission files. The bucket stays private: no r2.dev URL, no custom domain, no public
      // access. Objects are only read or written through this Worker (src/storage.ts).
      "binding": "FILES",
      "bucket_name": "inxapp-sms-files"
    }
  ],

  "vars": {
    // Browser origins allowed to upload files to the Worker directly (CORS). Comma-separated.
    "ALLOWED_ORIGINS": "http://localhost:3000"
  },

  // `wrangler deploy --env production` (docs/deployment.md). Bindings and vars are not inherited
  // from the top level, so they are repeated here. The secret WORKER_INTERNAL_SECRET is uploaded
  // with `wrangler deploy --env production --secrets-file <file outside the repo>`, never in this file.
  "env": {
    "production": {
      // Deployed as "inxapp-sms-api" (the name, not "<top-level name>-production").
      "name": "inxapp-sms-api",
      // Only reachable at the API hostname: no *.workers.dev URL, no preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      // sms.inxapp.net stays with the Next.js app on Vercel; the Worker gets its own hostname.
      "routes": [{ "pattern": "sms-api.inxapp.net", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "inxapp-sms",
          // From `wrangler d1 create inxapp-sms --location apac` (an identifier, not a secret).
          "database_id": "c42f77c8-7337-4cab-956f-aa2689d844f7",
          "migrations_dir": "../prisma/d1/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "inxapp-sms-files" }],
      "vars": {
        "ALLOWED_ORIGINS": "https://sms.inxapp.net"
      }
    }
  }
}
