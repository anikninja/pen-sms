{
  // Tests and scripts run in Node.js (vitest, tsx), not in the Worker runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"]
  },
  // The app's Auth.js type augmentation, for tests that load the Next.js data layer.
  "include": ["test/**/*.ts", "scripts/**/*.ts", "vitest.config.mts", "../src/types/**/*.d.ts"]
}
