{
  "name": "inx-sms-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: the API and database boundary for INX SMS (D1 via Prisma, R2 files). See API.md.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:seed:local": "node ../node_modules/tsx/dist/cli.mjs scripts/seed-local.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "wrangler": "4.135.0"
  }
}
