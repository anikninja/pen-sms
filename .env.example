# Copy this file to .env and fill in real values. Never commit .env.

# Where the app's data lives (src/lib/data/backend.ts):
#   "postgres" — Prisma straight to PostgreSQL (DATABASE_URL), files on the local disk.
#   "worker"   — the Cloudflare Worker API (WORKER_API_URL): D1 for data, private R2 for files.
# Unset means "postgres", but only outside Vercel: on Vercel it must be set explicitly.
DATA_BACKEND="postgres"

# Worker backend only. Server-side values: never prefix them with NEXT_PUBLIC_.
# Local: `npm --prefix worker run dev` serves the Worker on http://127.0.0.1:8787.
# WORKER_API_URL="http://127.0.0.1:8787"
# Same value as WORKER_INTERNAL_SECRET in worker/.dev.vars (and the Worker's Wrangler secret):
# at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# WORKER_INTERNAL_SECRET="replace-with-at-least-32-random-characters"

# PostgreSQL connection string used by Prisma (postgres backend only).
# Local:            postgresql://postgres:YOUR_PASSWORD@localhost:5432/pen_sms?schema=public
# Prisma Postgres:  the direct connection string from console.prisma.io (postgres://...@db.prisma.io:5432/postgres?sslmode=require).
#                   Use the direct "postgres://" URL, not a "prisma+postgres://" (Accelerate) URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pen_sms?schema=public"

# Secret used by Auth.js to sign and encrypt session cookies.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# "true" shows the seeded demo accounts on the login page. Set to "false" outside local demos.
DEMO_MODE="true"
