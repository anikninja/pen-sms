# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pen_sms?schema=public"

# Secret used by Auth.js to sign and encrypt session cookies.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# "true" shows the seeded demo accounts on the login page. Set to "false" outside local demos.
DEMO_MODE="true"
